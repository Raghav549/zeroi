ZEROI_ENV=dev
LOG_LEVEL=INFO

REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+asyncpg://zeroi:zeroi@postgres:5432/zeroi

# For local dev without Postgres:
# DATABASE_URL=sqlite+aiosqlite:///./.data/zeroi.db

ARTIFACT_BACKEND=local
ARTIFACT_LOCAL_DIR=.data/artifacts

# S3 / MinIO
ARTIFACT_BACKEND_S3=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=zeroi-artifacts
AWS_ACCESS_KEY_ID=zeroi
AWS_SECRET_ACCESS_KEY=zeroi-secret

# LLM for planner, DeepSearch, memory reasoning
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=
LLM_MODEL=qwen3-max

# Official Qwen-UI-Agent GUI execution engine
QWEN_UI_AGENT_URL=http://qwen-ui-agent:8010
QWEN_UI_AGENT_API_KEY=
QWEN_TIMEOUT=180

CLI_SANDBOX_MODE=subprocess
CLI_ALLOWLIST=ls,cat,mkdir,cp,mv,rm,zip,unzip,convert,ffmpeg,pandoc,git,python,echo,pwd,find,grep,jq

BROWSER_HEADLESS=true

SEARCH_PROVIDER=searxng
SEARXNG_URL=http://searxng:8080
SERPER_API_KEY=

AUTH_DISABLED=true
ZEROI_API_KEY=dev-key

OTEL_ENDPOINT=
